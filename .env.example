# Render / local backend
PORT=3000
NODE_ENV=production

# Comma-separated frontend origins allowed for CORS + Socket.io
ALLOWED_ORIGINS=https://syncnest-room.netlify.app

# Required in production — use a long random string
SYNCNEST_AUTH_SECRET=

# Netlify build — baked into public/config.js at deploy time
SYNCNEST_API_BASE=https://syncnest-backend.onrender.com

# Optional WebRTC TURN (recommended for video calls behind strict NAT)
# TURN_SERVER_URLS=turn:your-turn.example.com:3478
# TURN_SERVER_USERNAME=
# TURN_SERVER_CREDENTIAL=
